   function Table_Char (Pos : Positive) return Character
   is (Table_Lines ((Pos - 1) / Line_Size + 1) ((Pos - 1) mod Line_Size + 1));

   --  Read the hex digits of the table from Pos up to the next ':' or ';',
   --  and step over that
   procedure Read_Hex (Pos : in out Positive; Data : in out Bytes; Size : out Natural) is
      Digit : Natural;
   begin
      Size := 0;
      while Table_Char (Pos) not in ':' | ';' loop
         Digit := Character'Pos (Table_Char (Pos)) - (if Table_Char (Pos) <= '9' then 48 else 55);
         Size := Size + 1;
         Data (Count (Size)) := Byte (Digit) * 16;
         Pos := Pos + 1;
         Digit := Character'Pos (Table_Char (Pos)) - (if Table_Char (Pos) <= '9' then 48 else 55);
         Data (Count (Size)) := Data (Count (Size)) + Byte (Digit);
         Pos := Pos + 1;
      end loop;
      Pos := Pos + 1;
   end Read_Hex;

   function To_Encoding (Code : Character) return Encoding
   is (case Code is
         when 'A'    => US_ASCII,
         when '8'    => UTF_8,
         when 'l'    => UTF_16LE,
         when 'b'    => UTF_16BE,
         when 'L'    => UTF_32LE,
         when 'B'    => UTF_32BE,
         when others => Single_Byte);

   --  Check Condition, and say which entry of the table it is about if it
   --  is false
   procedure Verify (Condition : Boolean; Entry_Number : Positive; What : String) is
   begin
      Check (Condition, What);
      if not Condition then
         Ada.Text_IO.Put_Line ("  table entry" & Positive'Image (Entry_Number));
      end if;
   end Verify;

   --  Buffers of Test_Table.  They are not on the stack, which is small on a
   --  microcontroller.
   Source   : Bytes (1 .. 640) := (others => 0);
   Expected : Bytes (1 .. 640) := (others => 0);
   Target   : Bytes (1 .. 640) := (others => 0);
   Data     : Bytes (1 .. 640) := (others => 0);

   --  Items of the table: the bytes, in a buffer with 0xFF in front of and
   --  behind them; the verdict and the number of characters of Python; the
   --  UTF-8 form of Python
   procedure Test_Table is
      Pos      : Positive := 1;
      Number   : Natural := 0;
      Enc      : Encoding;
      Valid    : Boolean;
      Chars    : Natural;
      Src_Size : Natural;
      Exp_Size : Natural;
      Item     : Slice;
      Last     : Count;
      OK       : Boolean;

      --  The target is Target (11 .. 10 + Size), the other bytes up to
      --  Window are 0xAA
      Window : Count := 20;

      procedure Transcode (Size : Count) is
      begin
         Window := 20 + Size;
         Target (1 .. Window) := (others => 16#AA#);
         To_UTF_8 (Source, Item, Enc, Target (11 .. 10 + Size), Last, OK);
      end Transcode;

      function Untouched (First, Last : Count) return Boolean
      is (for all I in 1 .. Window => (if I not in First .. Last then Target (I) = 16#AA#));
   begin
      Group ("Strings: table of Python");
      while Pos <= Table_Length loop
         Number := Number + 1;
         Enc := To_Encoding (Table_Char (Pos));
         Valid := Table_Char (Pos + 1) = 'V';
         Pos := Pos + 2;
         Chars := 0;
         while Table_Char (Pos) /= ':' loop
            Chars := Chars * 10 + Character'Pos (Table_Char (Pos)) - 48;
            Pos := Pos + 1;
         end loop;
         Pos := Pos + 1;
         Read_Hex (Pos, Data, Src_Size);
         Source (1 .. 6 + Count (Src_Size)) := (others => 16#FF#);
         Source (4 .. 3 + Count (Src_Size)) := Data (1 .. Count (Src_Size));
         Item := (First => 4, Last => 3 + Count (Src_Size));
         Read_Hex (Pos, Expected, Exp_Size);

         Verify (Is_Valid (Source, Item, Enc) = Valid, Number, "Is_Valid as Python decodes");
         Verify (Is_Valid (Source, Item, Single_Byte), Number, "Single_Byte accepts everything");
         Verify (Max_UTF_8_Size (Item, Enc) >= Count (Exp_Size), Number, "Max_UTF_8_Size is a bound");
         if Valid then
            Verify (Character_Count (Source, Item, Enc) = Count (Chars), Number, "Character_Count as Python counts");
            Verify (UTF_8_Size (Source, Item, Enc) = Count (Exp_Size), Number, "UTF_8_Size as Python encodes");

            Transcode (Count (Exp_Size));
            Verify (OK, Number, "exact size: OK");
            Verify (Last = 10 + Count (Exp_Size), Number, "exact size: Last");
            Verify (Target (11 .. Last) = Expected (1 .. Count (Exp_Size)), Number, "exact size: bytes of Python");
            Verify (Untouched (11, Last), Number, "exact size: the other bytes are untouched");
            Verify
              (Is_Valid (Target, (First => 11, Last => Last), UTF_8)
               and then Character_Count (Target, (First => 11, Last => Last), UTF_8) = Count (Chars),
               Number,
               "the result is valid UTF-8 with the same number of characters");

            Transcode (Max_UTF_8_Size (Item, Enc));
            Verify (OK, Number, "Max_UTF_8_Size: OK");
            Verify (Last = 10 + Count (Exp_Size), Number, "Max_UTF_8_Size: Last");
            Verify (Target (11 .. Last) = Expected (1 .. Count (Exp_Size)), Number, "Max_UTF_8_Size: bytes of Python");
            Verify (Untouched (11, Last), Number, "Max_UTF_8_Size: the other bytes are untouched");

            Transcode (Count (Exp_Size) + 7);
            Verify (OK and then Last = 10 + Count (Exp_Size), Number, "larger target");
            Verify (Target (11 .. Last) = Expected (1 .. Count (Exp_Size)), Number, "larger target: bytes of Python");
            Verify (Untouched (11, Last), Number, "larger target: the other bytes are untouched");

            if Exp_Size > 0 then
               Transcode (Count (Exp_Size) - 1);
               Verify (not OK, Number, "one byte too small: not OK");
               Verify (Last = 10, Number, "one byte too small: Last");

               Transcode (0);
               Verify (not OK, Number, "empty target: not OK");
               Verify (Last = 10, Number, "empty target: Last");
            else
               Transcode (0);
               Verify (OK and then Last = 10, Number, "empty string, empty target");
               Verify (Untouched (11, 10), Number, "empty string: nothing is written");
            end if;
         else
            Verify (UTF_8_Size (Source, Item, Enc) = 0, Number, "UTF_8_Size of an invalid string");
            Transcode (Max_UTF_8_Size (Item, Enc));
            Verify (not OK, Number, "invalid: not OK");
            Verify (Last = 10, Number, "invalid: Last");
            Transcode (0);
            Verify (not OK and then Last = 10, Number, "invalid, empty target");
         end if;
      end loop;
      Check (Number > 1000, "all entries of the table were read");
   end Test_Table;

   --  Check that Data is valid or not in Enc
   procedure Check_Valid (Enc : Encoding; Data : Bytes; Expect : Boolean; What : String) is
   begin
      Check (Is_Valid (Data, (First => Data'First, Last => Data'Last), Enc) = Expect, What);
   end Check_Valid;

   procedure Check_Length (Enc : Encoding; Data : Bytes; Expect : Count; What : String) is
   begin
      Check (Character_Count (Data, (First => Data'First, Last => Data'Last), Enc) = Expect, What);
   end Check_Length;

   procedure Test_UTF_8 is
   begin
      Group ("Strings.Is_Valid: UTF-8 boundaries");
      Check_Valid (UTF_8, (1 .. 0 => 0), True, "empty");
      Check_Valid (UTF_8, (16#00#, 16#41#, 16#7F#), True, "ASCII including NUL and DEL");
      Check_Valid (UTF_8, (1 => 16#80#), False, "lone continuation byte 80");
      Check_Valid (UTF_8, (1 => 16#BF#), False, "lone continuation byte BF");
      Check_Valid (UTF_8, (16#C0#, 16#80#), False, "C0 is always overlong");
      Check_Valid (UTF_8, (16#C0#, 16#BF#), False, "C0 BF");
      Check_Valid (UTF_8, (16#C1#, 16#80#), False, "C1 is always overlong");
      Check_Valid (UTF_8, (16#C1#, 16#BF#), False, "C1 BF");
      Check_Valid (UTF_8, (16#C2#, 16#80#), True, "C2 80 is the first two byte sequence");
      Check_Valid (UTF_8, (16#C2#, 16#7F#), False, "C2 7F: second byte below 80");
      Check_Valid (UTF_8, (16#C2#, 16#C0#), False, "C2 C0: second byte above BF");
      Check_Valid (UTF_8, (16#DF#, 16#BF#), True, "DF BF is the last two byte sequence");
      Check_Valid (UTF_8, (1 => 16#C2#), False, "truncated after C2");
      Check_Valid (UTF_8, (1 => 16#DF#), False, "truncated after DF");
      Check_Valid (UTF_8, (16#E0#, 16#9F#, 16#BF#), False, "E0 9F is overlong");
      Check_Valid (UTF_8, (16#E0#, 16#A0#, 16#80#), True, "E0 A0 80 is the first three byte sequence");
      Check_Valid (UTF_8, (16#E0#, 16#BF#, 16#BF#), True, "E0 BF BF");
      Check_Valid (UTF_8, (16#E0#, 16#C0#, 16#80#), False, "E0 C0");
      Check_Valid (UTF_8, (16#E1#, 16#80#, 16#80#), True, "E1 80 80");
      Check_Valid (UTF_8, (16#E1#, 16#7F#, 16#80#), False, "E1 7F");
      Check_Valid (UTF_8, (16#EC#, 16#BF#, 16#BF#), True, "EC BF BF");
      Check_Valid (UTF_8, (16#ED#, 16#80#, 16#80#), True, "ED 80 80");
      Check_Valid (UTF_8, (16#ED#, 16#9F#, 16#BF#), True, "ED 9F BF is U+D7FF, below the surrogates");
      Check_Valid (UTF_8, (16#ED#, 16#A0#, 16#80#), False, "ED A0 80 is U+D800, a surrogate");
      Check_Valid (UTF_8, (16#ED#, 16#BF#, 16#BF#), False, "ED BF BF is U+DFFF, a surrogate");
      Check_Valid (UTF_8, (16#ED#, 16#A0#, 16#80#, 16#ED#, 16#B0#, 16#80#), False, "an encoded surrogate pair");
      Check_Valid (UTF_8, (16#EE#, 16#80#, 16#80#), True, "EE 80 80 is U+E000, above the surrogates");
      Check_Valid (UTF_8, (16#EF#, 16#BF#, 16#BF#), True, "EF BF BF is U+FFFF");
      Check_Valid (UTF_8, (16#E0#, 16#A0#), False, "three byte sequence cut after two");
      Check_Valid (UTF_8, (1 => 16#E0#), False, "three byte sequence cut after one");
      Check_Valid (UTF_8, (16#E2#, 16#82#), False, "E2 82 cut off");
      Check_Valid (UTF_8, (16#E2#, 16#82#, 16#41#), False, "E2 82 41: third byte is no continuation");
      Check_Valid (UTF_8, (16#E2#, 16#82#, 16#AC#), True, "euro sign");
      Check_Valid (UTF_8, (16#F0#, 16#8F#, 16#BF#, 16#BF#), False, "F0 8F is overlong");
      Check_Valid
        (UTF_8, (16#F0#, 16#90#, 16#80#, 16#80#), True, "F0 90 80 80 is U+10000, the first four byte sequence");
      Check_Valid (UTF_8, (16#F0#, 16#BF#, 16#BF#, 16#BF#), True, "F0 BF BF BF");
      Check_Valid (UTF_8, (16#F1#, 16#80#, 16#80#, 16#80#), True, "F1 80 80 80");
      Check_Valid (UTF_8, (16#F3#, 16#BF#, 16#BF#, 16#BF#), True, "F3 BF BF BF");
      Check_Valid (UTF_8, (16#F4#, 16#80#, 16#80#, 16#80#), True, "F4 80 80 80");
      Check_Valid (UTF_8, (16#F4#, 16#8F#, 16#BF#, 16#BF#), True, "F4 8F BF BF is U+10FFFF, the last character");
      Check_Valid (UTF_8, (16#F4#, 16#90#, 16#80#, 16#80#), False, "F4 90 80 80 is U+110000");
      Check_Valid (UTF_8, (16#F5#, 16#80#, 16#80#, 16#80#), False, "F5 is above U+10FFFF");
      Check_Valid (UTF_8, (16#F8#, 16#88#, 16#80#, 16#80#, 16#80#), False, "five byte form");
      Check_Valid (UTF_8, (16#FF#, 16#FF#), False, "FF");
      Check_Valid (UTF_8, (16#F0#, 16#90#, 16#80#), False, "four byte sequence cut after three");
      Check_Valid (UTF_8, (16#F0#, 16#90#), False, "four byte sequence cut after two");
      Check_Valid (UTF_8, (1 => 16#F0#), False, "four byte sequence cut after one");
      Check_Valid (UTF_8, (16#F0#, 16#90#, 16#80#, 16#41#), False, "fourth byte is no continuation");
      Check_Valid (UTF_8, (16#F0#, 16#90#, 16#C0#, 16#80#), False, "third byte is no continuation");
      Check_Valid
        (UTF_8, (16#41#, 16#C3#, 16#A9#, 16#E4#, 16#B8#, 16#96#, 16#F0#, 16#9F#, 16#98#, 16#80#), True, "mixed");
      Check_Valid
        (UTF_8, (16#41#, 16#C3#, 16#A9#, 16#E4#, 16#B8#, 16#96#, 16#F0#, 16#9F#, 16#98#), False, "mixed, cut");
      Check_Valid (UTF_8, (16#C3#, 16#A9#, 16#A9#), False, "stray continuation after a sequence");

      Group ("Strings.Is_Valid: slices");
      declare
         --                          1       2       3
         Data : constant Bytes := (16#41#, 16#C3#, 16#A9#, 16#FF#);
      begin
         Check (Is_Valid (Data, (First => 2, Last => 3), UTF_8), "a sequence in the middle");
         Check (not Is_Valid (Data, (First => 2, Last => 2), UTF_8), "cut by the end of the slice");
         Check (not Is_Valid (Data, (First => 3, Last => 3), UTF_8), "starts with a continuation byte");
         Check (Is_Valid (Data, (First => 1, Last => 3), UTF_8), "whole sequence, FF outside");
         Check (not Is_Valid (Data, (First => 1, Last => 4), UTF_8), "FF inside");
         Check (Is_Valid (Data, (First => 4, Last => 3), UTF_8), "empty slice, invalid byte after it");
         Check (not Is_Valid (Data, (First => 4, Last => 4), US_ASCII), "ASCII: byte above 127 at the end");
         Check (Is_Valid (Data, (First => 1, Last => 1), US_ASCII), "ASCII: one byte");
         Check (not Is_Valid (Data, (First => 2, Last => 3), US_ASCII), "ASCII: two bytes above 127");
         Check (Is_Valid (Data, (First => 2, Last => 3), Single_Byte), "Single_Byte");
      end;
   end Test_UTF_8;

   procedure Test_UTF_16 is
   begin
      Group ("Strings.Is_Valid: UTF-16");
      Check_Valid (UTF_16LE, (1 .. 0 => 0), True, "LE empty");
      Check_Valid (UTF_16BE, (1 .. 0 => 0), True, "BE empty");
      Check_Valid (UTF_16LE, (16#41#, 16#00#), True, "LE BMP");
      Check_Valid (UTF_16BE, (16#00#, 16#41#), True, "BE BMP");
      Check_Valid (UTF_16LE, (16#00#, 16#41#), True, "LE: 4100 is a character of the BMP too");
      Check_Valid (UTF_16LE, (16#FF#, 16#D7#), True, "LE U+D7FF");
      Check_Valid (UTF_16BE, (16#D7#, 16#FF#), True, "BE U+D7FF");
      Check_Valid (UTF_16LE, (16#00#, 16#E0#), True, "LE U+E000");
      Check_Valid (UTF_16BE, (16#E0#, 16#00#), True, "BE U+E000");
      Check_Valid (UTF_16LE, (16#FF#, 16#FF#), True, "LE U+FFFF");
      Check_Valid (UTF_16LE, (16#00#, 16#D8#, 16#00#, 16#DC#), True, "LE pair U+10000");
      Check_Valid (UTF_16BE, (16#D8#, 16#00#, 16#DC#, 16#00#), True, "BE pair U+10000");
      Check_Valid (UTF_16LE, (16#FF#, 16#DB#, 16#FF#, 16#DF#), True, "LE pair U+10FFFF");
      Check_Valid (UTF_16BE, (16#DB#, 16#FF#, 16#DF#, 16#FF#), True, "BE pair U+10FFFF");
      Check_Valid (UTF_16LE, (16#00#, 16#D8#), False, "LE lone high surrogate at the end");
      Check_Valid (UTF_16BE, (16#D8#, 16#00#), False, "BE lone high surrogate at the end");
      Check_Valid (UTF_16LE, (16#41#, 16#00#, 16#00#, 16#D8#), False, "LE character, then lone high surrogate");
      Check_Valid (UTF_16BE, (16#00#, 16#41#, 16#D8#, 16#00#), False, "BE character, then lone high surrogate");
      Check_Valid (UTF_16LE, (16#00#, 16#D8#, 16#41#, 16#00#), False, "LE high surrogate, then no low one");
      Check_Valid (UTF_16BE, (16#D8#, 16#00#, 16#00#, 16#41#), False, "BE high surrogate, then no low one");
      Check_Valid (UTF_16LE, (16#00#, 16#D8#, 16#00#, 16#D8#), False, "LE two high surrogates");
      Check_Valid (UTF_16LE, (16#00#, 16#D8#, 16#FF#, 16#DB#), False, "LE high surrogate, then high one");
      Check_Valid (UTF_16LE, (16#00#, 16#DC#), False, "LE lone low surrogate");
      Check_Valid (UTF_16BE, (16#DC#, 16#00#), False, "BE lone low surrogate");
      Check_Valid (UTF_16LE, (16#FF#, 16#DF#), False, "LE U+DFFF");
      Check_Valid (UTF_16LE, (16#00#, 16#DC#, 16#00#, 16#D8#), False, "LE low surrogate before a high one");
      Check_Valid (UTF_16BE, (16#DC#, 16#00#, 16#D8#, 16#00#), False, "BE low surrogate before a high one");
      Check_Valid (UTF_16LE, (16#41#, 16#00#, 16#00#, 16#DC#), False, "LE low surrogate after a character");
      Check_Valid (UTF_16LE, (1 => 16#41#), False, "LE odd length: one byte");
      Check_Valid (UTF_16BE, (1 => 16#00#), False, "BE odd length: one byte");
      Check_Valid (UTF_16LE, (16#41#, 16#00#, 16#42#), False, "LE odd length: three bytes");
      Check_Valid (UTF_16BE, (16#00#, 16#41#, 16#00#), False, "BE odd length: three bytes");
      Check_Valid (UTF_16LE, (16#00#, 16#D8#, 16#00#, 16#DC#, 16#41#), False, "LE pair and a stray byte");
      Check_Valid
        (UTF_16LE, (16#00#, 16#D8#, 16#00#, 16#DC#, 16#00#, 16#DC#), False, "LE pair, then lone low surrogate");
      Check_Valid (UTF_16LE, (16#00#, 16#D8#, 16#00#), False, "LE high surrogate and one more byte");
      Check_Valid (UTF_16LE, (16#00#, 16#D8#, 16#00#, 16#DC#, 16#00#, 16#D8#, 16#00#, 16#DC#), True, "LE two pairs");

      Group ("Strings.Is_Valid: UTF-16 slices");
      declare
         --                          1       2       3       4       5
         Data : constant Bytes := (16#00#, 16#41#, 16#00#, 16#D8#, 16#00#);
      begin
         Check (Is_Valid (Data, (First => 2, Last => 3), UTF_16LE), "slice that starts at an even position");
         Check (Is_Valid (Data, (First => 1, Last => 2), UTF_16BE), "BE character at the start");
         Check (Is_Valid (Data, (First => 2, Last => 5), UTF_16LE), "units 0041 and 00D8");
         Check
           (not Is_Valid (Data, (First => 3, Last => 4), UTF_16LE), "lone high surrogate D800 at the end of the slice");
         Check (not Is_Valid (Data, (First => 2, Last => 4), UTF_16LE), "odd length");
         Check (Is_Valid (Data, (First => 2, Last => 3), UTF_16LE), "the slice, not the buffer, decides");
         Check (Is_Valid (Data, (First => 5, Last => 4), UTF_16LE), "empty");
      end;
   end Test_UTF_16;

   procedure Test_Length is
   begin
      Group ("Strings.Length");
      Check_Length (UTF_8, (1 .. 0 => 0), 0, "UTF-8 empty");
      Check_Length (UTF_8, (16#41#, 16#42#), 2, "UTF-8 ASCII");
      Check_Length (UTF_8, (16#C3#, 16#A9#), 1, "UTF-8 two bytes");
      Check_Length (UTF_8, (16#E2#, 16#82#, 16#AC#), 1, "UTF-8 three bytes");
      Check_Length (UTF_8, (16#F0#, 16#9F#, 16#98#, 16#80#), 1, "UTF-8 four bytes: one character");
      Check_Length
        (UTF_8,
         (16#41#, 16#C3#, 16#A9#, 16#E2#, 16#82#, 16#AC#, 16#F0#, 16#9F#, 16#98#, 16#80#, 16#5A#),
         5,
         "UTF-8 mixed");
      Check_Length (UTF_16LE, (1 .. 0 => 0), 0, "UTF-16LE empty");
      Check_Length (UTF_16LE, (16#41#, 16#00#, 16#AC#, 16#20#), 2, "UTF-16LE BMP");
      Check_Length (UTF_16BE, (16#00#, 16#41#, 16#20#, 16#AC#), 2, "UTF-16BE BMP");
      Check_Length (UTF_16LE, (16#3D#, 16#D8#, 16#00#, 16#DE#), 1, "UTF-16LE pair: one character");
      Check_Length (UTF_16BE, (16#D8#, 16#3D#, 16#DE#, 16#00#), 1, "UTF-16BE pair: one character");
      Check_Length (UTF_16LE, (16#41#, 16#00#, 16#3D#, 16#D8#, 16#00#, 16#DE#, 16#42#, 16#00#), 3, "UTF-16LE mixed");
      Check_Length (UTF_16BE, (16#00#, 16#41#, 16#D8#, 16#3D#, 16#DE#, 16#00#, 16#00#, 16#42#), 3, "UTF-16BE mixed");
      Check_Length (US_ASCII, (16#41#, 16#42#, 16#43#), 3, "ASCII");
      Check_Length (US_ASCII, (1 .. 0 => 0), 0, "ASCII empty");
      Check_Length (Single_Byte, (16#E9#, 16#FF#, 16#00#, 16#80#), 4, "Single_Byte: every byte one character");

      Group ("Strings.Length: malformed input");
      Check_Length (UTF_8, (16#80#, 16#80#, 16#80#), 0, "UTF-8: continuation bytes do not count");
      Check_Length (UTF_8, (16#C3#, 16#A9#, 16#80#), 1, "UTF-8: stray continuation byte");
      Check_Length (UTF_8, (16#E2#, 16#82#), 1, "UTF-8: truncated sequence counts once");
      Check_Length (UTF_8, (16#FF#, 16#FF#), 2, "UTF-8: invalid lead bytes count");
      Check_Length (UTF_8, (16#F0#, 16#9F#, 16#98#, 16#80#, 16#41#), 2, "UTF-8: sequence and a byte");
      Check_Length (UTF_16LE, (16#41#, 16#00#, 16#42#), 1, "UTF-16: a last byte alone is ignored");
      Check_Length (UTF_16LE, (1 => 16#41#), 0, "UTF-16: one byte");
      Check_Length (UTF_16LE, (16#00#, 16#DC#), 0, "UTF-16LE: lone low surrogate does not count");
      Check_Length (UTF_16BE, (16#DC#, 16#00#), 0, "UTF-16BE: lone low surrogate does not count");
      Check_Length (UTF_16LE, (16#00#, 16#D8#), 1, "UTF-16LE: lone high surrogate counts");
      Check_Length (UTF_16BE, (16#D8#, 16#00#, 16#00#, 16#41#), 2, "UTF-16BE: high surrogate and a character");
      Check_Length (UTF_16LE, (16#41#, 16#00#, 16#42#, 16#00#, 16#43#), 2, "UTF-16: five bytes are two units");

      Group ("Strings.Length: slices");
      declare
         Data : constant Bytes := (16#41#, 16#C3#, 16#A9#, 16#FF#, 16#42#);
      begin
         Check (Character_Count (Data, (First => 2, Last => 3), UTF_8) = 1, "inner slice");
         Check (Character_Count (Data, (First => 3, Last => 2), UTF_8) = 0, "empty slice");
         Check (Character_Count (Data, (First => 1, Last => 5), UTF_8) = 4, "whole buffer");
         Check (Character_Count (Data, (First => 2, Last => 5), UTF_16LE) = 2, "UTF-16LE: two units");
         Check (Character_Count (Data, (First => 2, Last => 4), UTF_16LE) = 1, "UTF-16LE: three bytes");
         Check (Character_Count (Data, (First => 2, Last => 4), US_ASCII) = 3, "ASCII");
      end;
   end Test_Length;

   --  Set the bytes of Text into a buffer, with three bytes of '7' in front
   --  of them and behind them, which are digits in every base: if a function
   --  looks beyond the slice, the result changes.
   procedure Check_Int (Text : String; Base : S64; Expect_OK : Boolean; Expected : S64 := 0) is
      Buffer : Bytes (1 .. Count (Text'Length) + 6) := (others => 16#37#);
      Item   : constant Slice := (First => 4, Last => Count (Text'Length) + 3);
   begin
      for I in Text'Range loop
         Buffer (Count (I - Text'First) + 4) := Byte (Character'Pos (Text (I)));
      end loop;
      Check (To_Integer_OK (Buffer, Item, Base) = Expect_OK, Text);
      if Expect_OK and then To_Integer_OK (Buffer, Item, Base) then
         Check (To_Integer (Buffer, Item, Base) = Expected, Text);
      end if;
   end Check_Int;

