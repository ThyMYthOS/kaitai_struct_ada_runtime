   --  Put_Integer into a buffer of 30 bytes, in which Target is the part
   --  that begins at 6, with Size bytes; the others must stay as they are
   procedure Check_Put (Value : S64; Size : Count; Expected : String) is
      Buffer : Bytes (1 .. 30) := (others => 16#AA#);
      Last   : Count;
   begin
      Put_Integer (Value, Buffer (6 .. 5 + Size), Last);
      Check (Last = 5 + Count (Expected'Length), Expected);
      for I in Expected'Range loop
         Check (Buffer (Count (I - Expected'First) + 6) = Byte (Character'Pos (Expected (I))), Expected);
      end loop;
      Check (Buffer (1 .. 5) = (1 .. 5 => 16#AA#), "bytes before the target are not touched");
      Check (Buffer (Last + 1 .. 30) = (Last + 1 .. 30 => 16#AA#), "bytes after Last are not touched");
      Check (To_Integer_OK (Buffer, (First => 6, Last => Last), 10), "round trip: a number");
      Check (To_Integer (Buffer, (First => 6, Last => Last), 10) = Value, "round trip: the same number");
   end Check_Put;

   procedure Test_Put_Integer is
   begin
      Group ("Strings.Put_Integer");
      Check_Put (0, 24, "0");
      Check_Put (1, 24, "1");
      Check_Put (-1, 24, "-1");
      Check_Put (2, 24, "2");
      Check_Put (-2, 24, "-2");
      Check_Put (5, 24, "5");
      Check_Put (7, 24, "7");
      Check_Put (-7, 24, "-7");
      Check_Put (9, 24, "9");
      Check_Put (10, 24, "10");
      Check_Put (-10, 24, "-10");
      Check_Put (99, 24, "99");
      Check_Put (100, 24, "100");
      Check_Put (-100, 24, "-100");
      Check_Put (1234567890, 24, "1234567890");
      Check_Put (-1234567890, 24, "-1234567890");
      Check_Put (2**31 - 1, 24, "2147483647");
      Check_Put (-2**31, 24, "-2147483648");
      Check_Put (2**32, 24, "4294967296");
      Check_Put (10**18, 24, "1000000000000000000");
      Check_Put (-10**18, 24, "-1000000000000000000");
      Check_Put (10**18 - 1, 24, "999999999999999999");
      Check_Put (S64'Last, 24, "9223372036854775807");
      Check_Put (-S64'Last, 24, "-9223372036854775807");
      Check_Put (S64'First, 24, "-9223372036854775808");
      Check_Put (S64'Last - 1, 24, "9223372036854775806");
      Check_Put (S64'First + 1, 24, "-9223372036854775807");

      Group ("Strings.Put_Integer: 20 bytes");
      Check_Put (S64'First, 20, "-9223372036854775808");
      Check_Put (S64'Last, 20, "9223372036854775807");
      Check_Put (-S64'Last, 20, "-9223372036854775807");
      Check_Put (0, 20, "0");
      Check_Put (-1, 20, "-1");

      Group ("Strings.Put_Integer: target that does not start at 1");
      declare
         Buffer : Bytes (101 .. 130) := (others => 16#AA#);
         Last   : Count;
      begin
         Put_Integer (-45, Buffer, Last);
         Check (Last = 103, "last");
         Check (Buffer (101) = 45 and then Buffer (102) = 52 and then Buffer (103) = 53, "-45");
         Check (Buffer (104 .. 130) = (104 .. 130 => 16#AA#), "rest is untouched");
      end;
   end Test_Put_Integer;

   --  Content is the string in a buffer with '#' in front and behind
   procedure Check_Literal (Content, Literal : String; Expect : Boolean) is
      Buffer : Bytes (1 .. Count (Content'Length) + 4) := (others => 16#23#);
      Item   : constant Slice := (First => 3, Last => Count (Content'Length) + 2);
   begin
      for I in Content'Range loop
         Buffer (Count (I - Content'First) + 3) := Byte (Character'Pos (Content (I)));
      end loop;
      Check (Equal_Literal (Buffer, Item, Literal) = Expect, Content);
   end Check_Literal;

   procedure Test_Equal_Literal is
   begin
      Group ("Strings.Equal_Literal");
      Check_Literal ("abc", "abc", True);
      Check_Literal ("abc", "abd", False);
      Check_Literal ("abc", "xbc", False);
      Check_Literal ("abc", "axc", False);
      Check_Literal ("abc", "ab", False);
      Check_Literal ("abc", "abcd", False);
      Check_Literal ("abc", "", False);
      Check_Literal ("", "abc", False);
      Check_Literal ("", "", True);
      Check_Literal ("a", "a", True);
      Check_Literal ("a", "A", False);
      Check_Literal ("a", "#", False);
      Check_Literal ("abc", "abc#", False);
      Check_Literal ("abc", "#abc", False);
      Check_Literal ("a b", "a b", True);
      Check_Literal ((1 => Character'Val (0)), (1 => Character'Val (0)), True);
      Check_Literal ((1 => Character'Val (233)), (1 => Character'Val (233)), True);
      Check_Literal ((1 => Character'Val (233)), (1 => Character'Val (105)), False);
      Check_Literal ((1 => Character'Val (255)), (1 => Character'Val (255)), True);
      Check_Literal ((1 => Character'Val (255)), (1 => Character'Val (127)), False);
      Check_Literal (('a', Character'Val (200)), ('a', Character'Val (200)), True);

      Group ("Strings.Equal_Literal: literal with bounds other than 1");
      declare
         Text   : constant String (11 .. 13) := "abc";
         Buffer : constant Bytes := (16#61#, 16#62#, 16#63#);
      begin
         Check (Equal_Literal (Buffer, (First => 1, Last => 3), Text), "bounds 11 .. 13");
         Check (not Equal_Literal (Buffer, (First => 1, Last => 2), Text), "shorter");
         Check (Equal_Literal (Buffer, (First => 2, Last => 1), ""), "both empty");
         Check (Equal_Literal (Buffer, (First => 2, Last => 3), Text (12 .. 13)), "slice of the literal");
      end;
   end Test_Equal_Literal;

   procedure Test_UTF_32 is
   begin
      Group ("Strings: UTF-32");
      Check_Valid (UTF_32LE, (1 .. 0 => 0), True, "LE empty");
      Check_Valid (UTF_32BE, (1 .. 0 => 0), True, "BE empty");
      Check_Valid (UTF_32LE, (16#41#, 0, 0, 0), True, "LE BMP");
      Check_Valid (UTF_32BE, (0, 0, 0, 16#41#), True, "BE BMP");
      Check_Valid (UTF_32LE, (16#00#, 16#F6#, 16#01#, 0), True, "LE U+1F600");
      Check_Valid (UTF_32BE, (0, 16#01#, 16#F6#, 16#00#), True, "BE U+1F600");
      Check_Valid (UTF_32LE, (16#FF#, 16#FF#, 16#10#, 0), True, "LE U+10FFFF");
      Check_Valid (UTF_32BE, (0, 16#10#, 16#FF#, 16#FF#), True, "BE U+10FFFF");
      Check_Valid (UTF_32LE, (16#00#, 16#00#, 16#11#, 0), False, "LE U+110000");
      Check_Valid (UTF_32BE, (0, 16#11#, 16#00#, 16#00#), False, "BE U+110000");
      Check_Valid (UTF_32LE, (16#FF#, 16#FF#, 16#FF#, 16#FF#), False, "LE U+FFFFFFFF");
      Check_Valid (UTF_32LE, (0, 0, 0, 16#01#), False, "LE: the high byte is checked");
      Check_Valid (UTF_32BE, (16#01#, 0, 0, 0), False, "BE: the high byte is checked");
      Check_Valid (UTF_32LE, (16#FF#, 16#D7#, 0, 0), True, "LE U+D7FF");
      Check_Valid (UTF_32LE, (16#00#, 16#D8#, 0, 0), False, "LE U+D800");
      Check_Valid (UTF_32LE, (16#FF#, 16#DF#, 0, 0), False, "LE U+DFFF");
      Check_Valid (UTF_32LE, (16#00#, 16#E0#, 0, 0), True, "LE U+E000");
      Check_Valid (UTF_32BE, (0, 0, 16#D8#, 16#00#), False, "BE U+D800");
      Check_Valid (UTF_32BE, (0, 0, 16#DF#, 16#FF#), False, "BE U+DFFF");
      Check_Valid (UTF_32LE, (16#41#, 0, 0), False, "three bytes");
      Check_Valid (UTF_32LE, (16#41#, 0, 0, 0, 16#42#), False, "five bytes");
      Check_Valid (UTF_32BE, (0, 0, 0, 16#41#, 0, 0, 0), False, "seven bytes");
      Check_Valid (UTF_32LE, (1 => 16#41#), False, "one byte");
      Check_Valid (UTF_32LE, (16#41#, 0, 0, 0, 16#42#, 0, 0, 0), True, "two units");
      Check_Valid (UTF_32LE, (16#41#, 0, 0, 0, 0, 16#D8#, 0, 0), False, "valid unit, then a surrogate");

      Group ("Strings.Character_Count: UTF-32");
      Check_Length (UTF_32LE, (1 .. 0 => 0), 0, "empty");
      Check_Length (UTF_32LE, (16#41#, 0, 0, 0), 1, "one");
      Check_Length (UTF_32BE, (0, 0, 0, 16#41#, 0, 1, 16#F6#, 0), 2, "two");
      Check_Length (UTF_32LE, (16#41#, 0, 0, 0, 16#42#), 1, "a partial unit at the end is ignored");
      Check_Length (UTF_32LE, (16#41#, 0, 0), 0, "three bytes");
      Check_Length (UTF_32LE, (1 .. 7 => 0), 1, "seven bytes");
      Check_Length (UTF_32BE, (1 .. 8 => 16#FF#), 2, "invalid units count as well");
   end Test_UTF_32;

   --  Transcode Data and compare with Expected
   procedure Check_Transcode (Enc : Encoding; Data : Bytes; Expected : Bytes; What : String) is
      Target : Bytes (1 .. 40) := (others => 16#AA#);
      Last   : Count;
      OK     : Boolean;
      Item   : constant Slice := (First => Data'First, Last => Data'Last);
      Size   : constant Count := Expected'Length;
   begin
      To_UTF_8 (Data, Item, Enc, Target (5 .. 4 + Size), Last, OK);
      Check (OK and then Last = 4 + Size, What);
      Check (Target (5 .. Last) = Expected, What);
      Check (UTF_8_Size (Data, Item, Enc) = Size, What);
      Check (Target (1 .. 4) = (1 .. 4 => 16#AA#) and then Target (Last + 1 .. 40) = (Last + 1 .. 40 => 16#AA#), What);
   end Check_Transcode;

   procedure Check_No_Transcode (Enc : Encoding; Data : Bytes; Size : Count; What : String) is
      Target : Bytes (1 .. 40) := (others => 16#AA#);
      Last   : Count;
      OK     : Boolean;
   begin
      To_UTF_8 (Data, (First => Data'First, Last => Data'Last), Enc, Target (5 .. 4 + Size), Last, OK);
      Check (not OK and then Last = 4, What);
   end Check_No_Transcode;

   procedure Test_To_UTF_8 is
   begin
      Group ("Strings.To_UTF_8");
      Check_Transcode (UTF_8, (16#41#, 16#C3#, 16#A9#), (16#41#, 16#C3#, 16#A9#), "UTF-8 is copied");
      Check_Transcode (US_ASCII, (16#41#, 16#7F#), (16#41#, 16#7F#), "US_ASCII is copied");
      Check_Transcode (US_ASCII, (1 .. 0 => 0), (1 .. 0 => 0), "US_ASCII empty");
      Check_Transcode (Single_Byte, (16#41#, 16#7F#), (16#41#, 16#7F#), "Single_Byte below 128");
      Check_Transcode (Single_Byte, (1 => 16#80#), (16#C2#, 16#80#), "Single_Byte 80 is U+0080");
      Check_Transcode (Single_Byte, (16#E9#, 16#FF#), (16#C3#, 16#A9#, 16#C3#, 16#BF#), "Single_Byte E9 is U+00E9");
      Check_Transcode (UTF_16LE, (16#41#, 16#00#), (1 => 16#41#), "UTF-16LE U+0041");
      Check_Transcode (UTF_16BE, (16#00#, 16#7F#), (1 => 16#7F#), "UTF-16BE U+007F");
      Check_Transcode (UTF_16LE, (16#80#, 16#00#), (16#C2#, 16#80#), "UTF-16LE U+0080");
      Check_Transcode (UTF_16BE, (16#07#, 16#FF#), (16#DF#, 16#BF#), "UTF-16BE U+07FF");
      Check_Transcode (UTF_16BE, (16#08#, 16#00#), (16#E0#, 16#A0#, 16#80#), "UTF-16BE U+0800");
      Check_Transcode (UTF_16LE, (16#FF#, 16#FF#), (16#EF#, 16#BF#, 16#BF#), "UTF-16LE U+FFFF");
      Check_Transcode
        (UTF_16LE, (16#00#, 16#D8#, 16#00#, 16#DC#), (16#F0#, 16#90#, 16#80#, 16#80#), "UTF-16LE U+10000");
      Check_Transcode
        (UTF_16BE, (16#DB#, 16#FF#, 16#DF#, 16#FF#), (16#F4#, 16#8F#, 16#BF#, 16#BF#), "UTF-16BE U+10FFFF");
      Check_Transcode (UTF_32LE, (16#00#, 16#F6#, 16#01#, 0), (16#F0#, 16#9F#, 16#98#, 16#80#), "UTF-32LE U+1F600");
      Check_Transcode (UTF_32BE, (0, 16#10#, 16#FF#, 16#FF#), (16#F4#, 16#8F#, 16#BF#, 16#BF#), "UTF-32BE U+10FFFF");
      Check_Transcode
        (UTF_32BE, (0, 0, 0, 16#7F#, 0, 0, 0, 16#80#), (16#7F#, 16#C2#, 16#80#), "UTF-32BE U+007F U+0080");
      Check_Transcode (UTF_32LE, (1 .. 0 => 0), (1 .. 0 => 0), "UTF-32LE empty");

      Group ("Strings.To_UTF_8: failure");
      Check_No_Transcode (UTF_8, (16#41#, 16#C3#), 2, "invalid UTF-8");
      Check_No_Transcode (US_ASCII, (1 => 16#80#), 1, "invalid US_ASCII");
      Check_No_Transcode (UTF_16LE, (16#00#, 16#D8#), 4, "lone high surrogate");
      Check_No_Transcode (UTF_32LE, (16#00#, 16#00#, 16#11#, 0), 8, "U+110000");
      Check_No_Transcode (UTF_8, (16#41#, 16#42#), 1, "UTF-8 target too small");
      Check_No_Transcode (UTF_8, (16#41#, 16#42#), 0, "UTF-8 empty target");
      Check_No_Transcode (Single_Byte, (16#41#, 16#E9#), 2, "Single_Byte target too small");
      Check_No_Transcode
        (UTF_16LE, (16#41#, 16#00#, 16#AC#, 16#20#), 3, "UTF-16 target too small for the last character");
      Check_No_Transcode (UTF_32LE, (16#00#, 16#F6#, 16#01#, 0), 3, "UTF-32 target too small");

      Group ("Strings.To_UTF_8: target that does not start at 1");
      declare
         Target : Bytes (101 .. 110) := (others => 16#AA#);
         Last   : Count;
         OK     : Boolean;
         Data   : constant Bytes := (16#41#, 0, 16#AC#, 16#20#);
      begin
         To_UTF_8 (Data, (First => 1, Last => 4), UTF_16LE, Target, Last, OK);
         Check (OK and then Last = 104, "last");
         Check (Target (101 .. 104) = (16#41#, 16#E2#, 16#82#, 16#AC#), "bytes");
         Check (Target (105 .. 110) = (105 .. 110 => 16#AA#), "rest is untouched");
      end;
      declare
         Target : Bytes (101 .. 100);
         Last   : Count;
         OK     : Boolean;
      begin
         To_UTF_8 ((1 => 16#41#), (First => 1, Last => 0), UTF_8, Target, Last, OK);
         Check (OK and then Last = 100, "empty string into an empty target");
         To_UTF_8 ((1 => 16#41#), (First => 1, Last => 1), UTF_8, Target, Last, OK);
         Check (not OK and then Last = 100, "one byte into an empty target");
      end;

      Group ("Strings.Max_UTF_8_Size");
      Check (Max_UTF_8_Size ((First => 1, Last => 10), UTF_8) = 10, "UTF-8");
      Check (Max_UTF_8_Size ((First => 1, Last => 10), US_ASCII) = 10, "US_ASCII");
      Check (Max_UTF_8_Size ((First => 1, Last => 10), UTF_16LE) = 15, "UTF-16");
      Check (Max_UTF_8_Size ((First => 1, Last => 11), UTF_16BE) = 16, "UTF-16, odd");
      Check (Max_UTF_8_Size ((First => 1, Last => 10), UTF_32LE) = 10, "UTF-32");
      Check (Max_UTF_8_Size ((First => 1, Last => 10), Single_Byte) = 20, "Single_Byte");
      Check (Max_UTF_8_Size ((First => 5, Last => 4), Single_Byte) = 0, "empty");
      Check (Max_UTF_8_Size ((First => 1, Last => Count'Last - 1), Single_Byte) = Count'Last, "saturates");
      Check (Max_UTF_8_Size ((First => 1, Last => Count'Last - 1), UTF_16LE) = Count'Last, "saturates, UTF-16");
   end Test_To_UTF_8;

   procedure Run is
   begin
      Test_Table;
      Test_UTF_8;
      Test_UTF_16;
      Test_Length;
      Test_To_Integer;
      Test_Put_Integer;
      Test_Equal_Literal;
      Test_UTF_32;
      Test_To_UTF_8;
   end Run;

end Strings_Tests;
