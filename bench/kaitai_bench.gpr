with "kaitai_struct.gpr";
with "../kaitai_style.gpr";

--  Benchmarks are built with fixed, explicit switches so that results are
--  comparable.  MODE selects what a variant is allowed to rely on:
--
--    checked  : -O2, all run-time checks on, no cross-unit inlining
--    inlined  : -O2 -gnatn, run-time checks on
--    proven   : -O2 -gnatn -gnatp, as if all checks were proven absent
--
--  The scripts build the library to match: KAITAI_STRUCT_CHECKS=proven in
--  mode "proven", "enabled" otherwise.
project Kaitai_Bench is

   type Mode_Type is ("checked", "inlined", "proven");
   Mode : Mode_Type := external ("MODE", "inlined");

   Switches := ("-O2", "-g", "-gnat2022", "-gnatwa") & Kaitai_Style.Style_Switches;

   case Mode is
      when "checked" => null;
      when "inlined" => Switches := Switches & ("-gnatn");
      when "proven"  => Switches := Switches & ("-gnatn", "-gnatp");
   end case;

   for Source_Dirs use ("src/");
   for Object_Dir use "obj/" & Mode;
   for Create_Missing_Dirs use "True";
   for Exec_Dir use "bin/" & Mode;
   for Main use ("memory_bench.adb", "stream_bench.adb", "parse_bench.adb");

   package Compiler is
      for Default_Switches ("Ada") use Switches;
   end Compiler;

   package Format renames Kaitai_Style.Format;

end Kaitai_Bench;
